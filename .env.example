# Copy this file to ".env" and adjust the values for your machine.

# --- Django core ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Set DB_ENGINE=mysql once MySQL is installed and running (matches Chapter 3, section 3.6.4).
# Leave as sqlite (or unset) to run/test the project immediately with zero extra setup.
DB_ENGINE=sqlite
DB_NAME=bouesti_erecruitment
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
